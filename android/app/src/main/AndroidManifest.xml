<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- In C4 Cloud-enabled builds, file/text/EHI/NUR decode requests use
         the native HTTPS libv7q3.so client. Encrypted history remains
         local. C4 never enables cleartext, analytics, or background requests.
         QA APK/APKS alone may use a single WorkManager network job
         after explicit file consent; other decoders retain their policies.
         Legacy builds are retained for migration regression checks until C5. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".SpDecodeApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.SPDecode.Starting">
        <!-- Disabled and hidden from launcher for every non-QA build. -->
        <activity
            android:name=".cloud.CloudQaSetupActivity"
            android:exported="true"
            android:enabled="${spdecodeQaEnabled}"
            android:label="SP-DECODE QA"
            android:theme="@style/Theme.SPDecode.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:documentLaunchMode="never"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
