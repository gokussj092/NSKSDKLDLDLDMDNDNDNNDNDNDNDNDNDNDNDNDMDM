#pragma once
// Encoded public addresses; no server credential is compiled into the app.
#include <string>
namespace {
template <size_t N> std::string cloudString(const volatile unsigned char (&bytes)[N]) {
    std::string decoded; decoded.reserve(N-1);
    for(size_t i=0;i<N-1;++i)
        decoded.push_back(static_cast<char>(bytes[i] ^ ((@SPDECODE_STRING_KEY@ + i*31) & 255)));
    return decoded;
}
std::string cloudOrigin() {
    const volatile unsigned char encoded[]={@SPDECODE_ORIGIN_BYTES@};
    return cloudString(encoded);
}
std::string cloudTransportPath() {
    const volatile unsigned char encoded[]={@SPDECODE_PATH_BYTES@};
    return cloudString(encoded);
}
}
