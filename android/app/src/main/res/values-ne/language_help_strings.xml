<resources>
    <string name="language_help_title">अनुवाद सुधार्न मद्दत गर्नुहोस्</string>
    <string name="language_help_detail">अनुवादका त्रुटि बताउनुहोस् ताकि हामी तिनलाई सच्याउन सकौँ।</string>
    <string name="language_help_signin_title">रिपोर्ट गर्न साइन इन गर्नुहोस्</string>
    <string name="language_help_signin_detail">अनुवादको त्रुटि रिपोर्ट गर्न आफ्नो खातामा साइन इन गर्नुहोस्।</string>
    <string name="language_help_signin_button">साइन इन गर्नुहोस्</string>
    <string name="language_help_form_title">अनुवादको त्रुटि रिपोर्ट गर्नुहोस्</string>
    <string name="language_help_language_label">भाषा</string>
    <string name="language_help_where_label">तपाईंले त्रुटि कहाँ देख्नुभयो?</string>
    <string name="language_help_wrong_label">गलत पाठ (देखिएजस्तै)</string>
