    <string name="hc_auth_input_invalid">தேவையான கடவுச்சொல் மற்றும்/அல்லது செல்லுபடியாகும் 32 எழுத்து HWID-ஐ உள்ளிடவும்.</string>
    <string name="hc_auth_failed">இந்தப் பாதுகாக்கப்பட்ட HTTP Custom கோப்பை அங்கீகரிக்க முடியவில்லை. கடவுச்சொல் மற்றும்/அல்லது HWID-ஐச் சரிபார்க்கவும்; கோப்பு சேதமடைந்திருக்கலாம் அல்லது ஆதரிக்கப்படாத மாறுபாட்டைப் பயன்படுத்தலாம்.</string>
    <string name="guide_step_six">APK பகுப்பாய்வு: இந்த அம்சம் விரைவில் வருகிறது.</string>
    <string name="guide_step_seven">VPN சர்வர்கள்: ஒரு செயலியைத் தேர்ந்து அதன் சர்வர் பட்டியலை மறைகுறியீடு நீக்கவும்.</string>
    <string name="guide_step_eight">அமைப்புகள்: மொழியைத் தேர்வுசெய்து, தனியுரிமைத் தகவலை மதிப்பாய்வு செய்து, செயலி விருப்பங்களை நிர்வகிக்கவும்.</string>
    <string name="server_vpn">Server VPN</string>
    <string name="server_vpn_description">ஆதரிக்கப்படும் VPN சர்வர் பட்டியல்களை உலாவுக. அங்கீகரிக்கப்பட்ட சர்வர் பட்டியலை மறைகுறியீடு நீக்க ஒரு செயலியைத் தேர்வுசெய்யவும்.</string>
    <string name="nur_tunnel_name">NUR TUNNEL VPN</string>
    <string name="nur_servers_description">NUR Tunnel VPN 1.0.8.8-க்கான குறியாக்கம் செய்யப்பட்ட சர்வர் பட்டியலை மறைகுறியீடு நீக்கவும்.</string>
    <string name="nur_servers_catalog_url">குறியாக்கம் செய்யப்பட்ட சர்வர் பட்டியல் URL</string>
    <string name="nur_servers_privacy">நீங்கள் மறைகுறியீடு நீக்கு என்பதைத் தட்டும்போது மட்டும் ஆன்லைன். HTTPS தேவை. முடிவுகள் காட்டப்படும் முன் அங்கீகரிக்கப்பட்டு, குறியாக்கம் செய்யப்பட்ட உள்ளூர் வரலாற்றில் சேமிக்கப்படுகின்றன.</string>
    <string name="nur_servers_decode">சர்வர்களை மறைகுறியீடு நீக்கு</string>
    <string name="nur_servers_invalid_url">சர்வர் பட்டியலுக்குச் செல்லுபடியாகும் HTTPS URL-ஐ உள்ளிடவும்.</string>
    <string name="nur_servers_failed">சர்வர் பட்டியலைப் பதிவிறக்கவோ, அங்கீகரிக்கவோ அல்லது மறைகுறியீடு நீக்கவோ முடியவில்லை.</string>
