  "openapi": "3.1.0",
  "info": {
    "title": "SP-DECODE Cloud API — C3 gated security contract",
    "version": "0.3.5",
    "description": "Security-gated C3.5: remote imports only from fixed HTTPS provider origins; authentication, explicit consent, and private worker are required. No Android changes. Native library libspdecode.so is planned for C4."
  },
