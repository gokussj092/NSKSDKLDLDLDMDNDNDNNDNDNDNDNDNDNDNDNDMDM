    "/api/v1/server-vpn/decode": {
      "post": {
        "summary": "Authenticated, consented server-side VPN provider catalog decoding",
        "description": "Requires Play Integrity session, service toggle, fixed provider URL, bounded retries and isolated Python worker.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "consent"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "24clan-green",
                      "hx-tunnel",
                      "mkk-hyper",
                      "my-tunnel-proxy",
                      "robust-tunnel",
                      "trv-tunnel",
                      "4u-tunnel-lite",
                      "ac-tunnel-vpn",
                      "austroplus-vpn"
                    ]
                  },
                  "consent": {
                    "type": "boolean",
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete, validated result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required for decoding"
          },
          "413": {
            "description": "Payload exceeds configured limit"
          },
          "422": {
            "description": "Decoding or authentication failed"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service unavailable or disabled"
          }
        }
      }
    }
