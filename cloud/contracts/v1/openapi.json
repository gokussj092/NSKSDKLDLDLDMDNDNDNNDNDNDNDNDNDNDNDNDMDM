      "get": {
        "summary": "Liveness (no decoder readiness implied)",
        "responses": {
          "200": {
            "description": "Process alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "apiVersion",
                    "status"
                  ],
                  "properties": {
                    "apiVersion": {
                      "type": "string",
                      "const": "v1"
                    },
                    "status": {
                      "type": "string",
                      "const": "alive"
                    },
                    "service": {
                      "type": "string"
                    },
                    "phase": {
                      "type": "string"
                    }
