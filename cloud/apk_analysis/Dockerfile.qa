# Isolated bounded deep APK/APKS metadata QA. Not the VPN decoder worker.
# Does not execute apps, decompilers, shell, or unreviewed research tools.
FROM python:3.12-alpine
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/spdecode
WORKDIR /opt/spdecode
COPY cloud/apk_analysis/__init__.py cloud/apk_analysis/input_gate.py \
     cloud/apk_analysis/qa_dex_bytecode.py cloud/apk_analysis/qa_deep.py \
     cloud/apk_analysis/qa_jadx_refs.py cloud/apk_analysis/qa_jadx_recovery.py \
     cloud/apk_analysis/qa_tool_plan.py cloud/apk_analysis/qa_tool_rpc.py \
     cloud/apk_analysis/qa_full_profile.py cloud/apk_analysis/qa_method_recipes.py \
     cloud/apk_analysis/qa_tooling.py \
     cloud/apk_analysis/qa_identity.py cloud/apk_analysis/qa_tool_harness.py cloud/apk_analysis/qa_static.py cloud/apk_analysis/qa_service.py ./cloud/apk_analysis/
# Fail Docker build immediately if any APK QA Python module is malformed.
RUN python3 -m compileall -q cloud/apk_analysis
RUN mkdir -p /var/lib/spdecode/apkqa && \
    chown -R 65532:65532 /var/lib/spdecode/apkqa /opt/spdecode && \
    chmod 0700 /var/lib/spdecode/apkqa
USER 65532:65532
EXPOSE 8792
CMD ["python","-B","-m","cloud.apk_analysis.qa_service"]
