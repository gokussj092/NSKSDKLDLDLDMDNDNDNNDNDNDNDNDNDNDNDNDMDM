# Review before use. C3 is NOT approved for public production deployment yet.
# Replace domain, cert files, enable HTTPS, and keep port 3000 loopback-bound.
# Do not forward untrusted X-Real-IP or X-Forwarded-For from a client.
# Empty map key exempts catalog/status/notification requests from decoder edge
# accounting; all routes retain normal application auth, replay and size checks.
map "$uri:$http_x_sp_operation" $spdecode_expensive_key {
    default "";
    ~^/api/v2/transport:(4|5|6|7|8|9|12)$ $binary_remote_addr;
    ~^/api/v1/(npvs/identity|decode/(file|text|import/cloud|import/http-custom|import/catalog/remote)|server-vpn/decode)$ $binary_remote_addr;
}
limit_req_zone $spdecode_expensive_key zone=spdecode_v2_edge:10m rate=10r/s;
server {
    listen 80;
    server_name spdecode.example.com;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name spdecode.example.com;
    ssl_certificate /etc/letsencrypt/live/spdecode.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/spdecode.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 12m;
    client_body_timeout 15s;
    client_header_timeout 10s;
    keepalive_timeout 10s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location /api/ {
        access_log off;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite rather than trust client-provided forwarding chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 4s;
        proxy_send_timeout 15s;
        # V2 multiplexes operations; workers retain their own short deadlines.
        proxy_read_timeout 155s;
        limit_req zone=spdecode_v2_edge burst=60 nodelay;
        limit_req_status 429;
        proxy_redirect off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
    }
}
